# Bluesky: create an App Password at Settings > Privacy and security > App passwords
BLUESKY_HANDLE=yourname.bsky.social
BLUESKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Supabase (needed on Vercel, whose disk is read-only). Dashboard -> Project Settings -> API.
# Use the service_role key: server-side only, never put it in browser code or commit it.
# Leave empty locally to store posts in data/posts.json. Run supabase/schema.sql once first.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: protects /api/cron. Your cron service must send "Authorization: Bearer <this>".
CRON_SECRET=
